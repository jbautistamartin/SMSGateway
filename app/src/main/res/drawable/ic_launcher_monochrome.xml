<?xml version="1.0" encoding="utf-8"?>
<!--
    Capa monocroma para los iconos temáticos de Android 13+.

    Es la misma silueta que el primer plano, en negro sobre transparente: el sistema la recolorea
    con el tema del usuario. Sin esta capa, el lanzador deja el icono fuera del tratamiento
    temático y queda como el único que no sigue al resto —que es literalmente lo que pasaba aquí
    antes: las otras tres aplicaciones tenían capa monocroma y SMSGateway no, así que con los
    iconos temáticos activados era el único que seguía en su color.

    **Las dos rutas tienen que ser idénticas.** Si se edita la flecha en una y no en la otra, el
    icono cambia de forma al activar los iconos temáticos y nadie relaciona el síntoma con la
    causa.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        El dibujo se reduce al 85 % sobre el centro, igual que en el primer plano: a tamaño
        completo el bocadillo casi tocaba el borde de la máscara y el icono se veía apretado al
        lado de los demás del lanzador. Escalar con un grupo, en vez de reescribir las
        coordenadas, deja la ruta legible y comparable con la del primer plano, que lleva
        exactamente la misma.
    -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.85"
        android:scaleY="0.85">

        <path
            android:fillColor="#000000"
            android:fillType="evenOdd"
            android:pathData="M38,26 L70,26 A12,12 0 0 1 82,38 L82,58 A12,12 0 0 1 70,70 L52,70 L38,84 L38,70 A12,12 0 0 1 26,58 L26,38 A12,12 0 0 1 38,26 Z
                              M54,35 L68,49 L60,49 L60,61 L48,61 L48,49 L40,49 Z" />
    </group>

</vector>
